# Block all direct HTTP access to this directory. Only PHP scripts in
# ../api/ (which read these files server-side via file_get_contents) may
# use this data. This is a second layer of defense on top of the PHP
# guard line each data file starts with.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
